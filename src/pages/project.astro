---
import { getEntry, render } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import Main from "@/components/Main.astro";
import Footer from "@/components/Footer.astro";
import config from "@/config";

const project = await getEntry("pages", "project");
if (!project) {
  throw new Error(
    "Missing content entry: `project.md` or `project.mdx` in `src/content/pages/`"
  );
}
const { Content } = await render(project);
---

<Layout
  title={`${project.data.title} | ${config.site.title}`}
  description={project.data.description}
  ogImage={project.data.ogImage}
  canonicalURL={project.data.canonicalURL}
>
  <Header />
  <Breadcrumb />
  <Main pageTitle={project.data.title} class="app-prose">
    <Content />
  </Main>
  <Footer />
</Layout>
